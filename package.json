{
  "name": "local-agent",
  "displayName": "NIGHTFALL // Local Agent",
  "description": "A small local-first coding agent for VS Code and OpenAI-compatible servers.",
  "version": "0.2.3",
  "icon": "media/nightfall-icon.png",
  "publisher": "local-agent",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:localAgent.openChat",
    "onCommand:localAgent.stopSession",
    "onCommand:localAgent.addFilesToContext",
    "onCommand:localAgent.addSkill",
    "onCommand:localAgent.addMcpServer",
    "onCommand:localAgent.showHistory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localAgent.openChat",
        "title": "Local Agent: Open Chat"
      },
      {
        "command": "localAgent.newSession",
        "title": "Local Agent: New Session"
      },
      {
        "command": "localAgent.clearSession",
        "title": "Local Agent: Clear Session"
      },
      {
        "command": "localAgent.configureModel",
        "title": "Local Agent: Configure Model"
      },
      {
        "command": "localAgent.stopSession",
        "title": "Local Agent: Stop Session"
      },
      {
        "command": "localAgent.addFilesToContext",
        "title": "Local Agent: Add Files to Context"
      },
      {
        "command": "localAgent.addSkill",
        "title": "Local Agent: Add Skill"
      },
      {
        "command": "localAgent.addMcpServer",
        "title": "Local Agent: Add MCP Server"
      },
      {
        "command": "localAgent.showHistory",
        "title": "Local Agent: Show Session History"
      },
      {
        "command": "localAgent.restoreLastSnapshot",
        "title": "Local Agent: Restore Last Snapshot"
      }
    ],
    "configuration": {
      "title": "Local Agent",
      "properties": {
        "localAgent.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8082/v1"
        },
        "localAgent.apiKey": {
          "type": "string",
          "default": "local"
        },
        "localAgent.model": {
          "type": "string",
          "default": "LFM2.5-2.6B-Q4_K_M"
        },
        "localAgent.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2
        },
        "localAgent.maxIterations": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100
        },
        "localAgent.contextWindow": {
          "type": "number",
          "default": 32768,
          "minimum": 1000,
          "description": "Model context window size in tokens, used by automatic compaction."
        },
        "localAgent.autoCompactionLimit": {
          "type": ["number", "null"],
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "Compact when context reaches this percentage of the model window. Leave null to use the safety buffer only."
        },
        "localAgent.pruneOldOutputs": {
          "type": "boolean",
          "default": false,
          "description": "Remove old tool outputs during compaction."
        },
        "localAgent.enableSnapshots": {
          "type": "boolean",
          "default": false,
          "description": "Create a checkpoint before each existing file edit so the previous state can be restored."
        },
        "localAgent.lightMode": {
          "type": "boolean",
          "default": false,
          "description": "Use the light theme in the chat panel."
        },
        "localAgent.requestTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 1000
        },
        "localAgent.autoApproveReads": {
          "type": "boolean",
          "default": true
        },
        "localAgent.autoApproveWrites": {
          "type": "boolean",
          "default": false
        },
        "localAgent.autoApproveTerminal": {
          "type": "boolean",
          "default": false
        },
        "localAgent.autoApproveTools": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve external/MCP tool calls."
        },
        "localAgent.autoApproveFileOperations": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve write_file operations."
        },
        "localAgent.skillFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative Markdown files whose instructions are included as skills."
        },
        "localAgent.mcpServers": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": [],
          "description": "MCP server definitions. Use command for stdio or url with transport streamable-http/sse for remote servers."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "vitest run",
    "watch": "tsc -watch -p .",
    "package": "npm run compile && esbuild dist/extension.js --bundle --platform=node --format=cjs --external:vscode --allow-overwrite --outfile=dist/extension.js && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
